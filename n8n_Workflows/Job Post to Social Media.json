        "jsCode": "const jobPost = $input.item.json.body.jobPost;\n\nconst message = `🎯 ${jobPost.jobTitle}\\n\\n📍 Location: ${jobPost.location}\\n💼 Job Type: ${jobPost.jobType}\\n💰 Salary: ${jobPost.salary}\\n📚 Experience: ${jobPost.experience}\\n🎓 Education: ${jobPost.education}\\n\\n📝 Description:\\n${jobPost.description}\\n\\n${jobPost.skills ? `🔧 Skills: ${jobPost.skills}` : ''}\\n\\n${jobPost.deadline ? `⏰ Deadline: ${jobPost.deadline}` : ''}\\n\\n🔗 Apply Now: ${jobPost.applicationUrl}`;\n\n// Explicitly carry binary forward\nconst binaryData = $input.item.binary ?? {};\n\nreturn {\n  json: {\n    message: message,\n    jobPost: jobPost\n  },\n  binary: binaryData\n};"
      },
